# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre projet Supabase
# (Supabase > Project Settings > Data API et API Keys)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique : "Publishable key" (sb_publishable_...) ou l'ancienne "anon key"
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
